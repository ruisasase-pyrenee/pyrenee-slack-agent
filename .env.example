# ── Slack ──────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ── Google API (Gmail + Calendar) ──────────────────────────────────────────────
# Setup: Google Cloud Console → OAuth 2.0 → credentials.json をこのディレクトリに配置
# 初回起動時にブラウザ認証が走り token.json が自動生成される
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_ID=primary

# ── Notion ─────────────────────────────────────────────────────────────────────
# Notion Integration Token: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxx
# ミーティング記録用データベースのID（NotionページURLの末尾32文字）
NOTION_MEETINGS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Scheduler / 自動送信 ────────────────────────────────────────────────────────
# Rui の Slack ユーザーID (DM送信先)
# 確認方法: Slackでプロフィールを開き「メンバーIDをコピー」
RUI_SLACK_USER_ID=U0XXXXXXXXX

# 朝のダイジェスト送信時刻 (America/Los_Angeles)
MORNING_DIGEST_HOUR=8
MORNING_DIGEST_MIN=30

# 自動トリアージの実行間隔（時間）
TRIAGE_INTERVAL_HOURS=2
